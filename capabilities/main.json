{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The aidget main window controls the window and startup preference.",
  "windows": ["main"],
  "permissions": [
    "allow-main-state",
    "allow-main-painted",
    "allow-main-widget-cached-preview",
    "allow-main-widget-details",
    "allow-integration-state",
    "allow-set-agent-integration",
    "allow-set-preferences",
    "allow-set-github-token",
    "allow-set-widget-enabled",
    "allow-delete-widget",
    "allow-restore-widget",
    "allow-deleted-widget-preview",
    "allow-purge-deleted-widget",
    "allow-main-widget-preview",
    "allow-community-list",
    "allow-community-media",
    "allow-community-install",
    "allow-community-downloads",
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/aidget-ai/aidget"
        },
        {
          "url": "https://github.com/aidget-ai/widgets"
        }
      ]
    }
  ]
}
