{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aidget",
  "version": "0.1.1",
  "identifier": "dev.aidget.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "beforeDevCommand": "pnpm run build:ui",
    "beforeBuildCommand": "pnpm run build:ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
